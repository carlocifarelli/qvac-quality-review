{
  "name": "agentic-code-review",
  "version": "0.2.0",
  "description": "Find, verify and rank defects worth fixing in a JS/TS repository: an AI agent discovers, an adversarial pass and a human verify, deterministic ESLint rules keep the bug classes from coming back",
  "license": "MIT",
  "author": "Carlo Cifarelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlocifarelli/agentic-code-review.git"
  },
  "keywords": [
    "code-review",
    "ai",
    "llm",
    "agents",
    "claude",
    "eslint",
    "eslint-plugin",
    "static-analysis",
    "github-action",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "qr": "./dist/cli.js"
  },
  "exports": {
    "./eslint-plugin": "./dist/rules/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "qr": "tsx src/cli.ts",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "eslint": "^9.39.5",
    "picomatch": "^4.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
