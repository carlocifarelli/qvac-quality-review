{
  "name": "qvac-quality-review",
  "version": "0.1.0",
  "description": "Find, verify and rank defects worth fixing in a JS/TS repository (applied to tetherto/qvac)",
  "type": "module",
  "bin": {
    "qr": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "qr": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "eslint": "^9.39.5",
    "picomatch": "^4.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
